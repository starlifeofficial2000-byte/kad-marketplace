# Server
PORT=5000
NODE_ENV=development

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=https://your-frontend-domain.example,https://www.your-frontend-domain.example
SITE_URL=https://your-frontend-domain.example

# MySQL database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kad_marketplace
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Authentication (generate a long random secret)
JWT_SECRET=replace_with_a_long_random_secret

# Paystack
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_CALLBACK=https://your-frontend-domain.example/payment-success
PROMOTION_CALLBACK=https://your-frontend-domain.example/promotion-success

# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_REGION=auto
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your_public_cdn_domain

# Email provider
RESEND_API_KEY=re_replace_me
